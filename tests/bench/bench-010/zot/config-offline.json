{
    "distSpecVersion": "1.1.1",
    "storage": {
        "rootDirectory": "/var/lib/registry",
        "dedupe": false,
        "gc": false
    },
    "http": {
        "address": "0.0.0.0",
        "port": "5000",
        "compat": [
            "docker2s2"
        ]
    },
    "log": {
        "level": "info"
    },
    "extensions": {
        "sync": {
            "enable": true,
            "registries": [
                {
                    "urls": [
                        "https://127.0.0.1:9"
                    ],
                    "onDemand": true,
                    "tlsVerify": true
                }
            ]
        }
    }
}
