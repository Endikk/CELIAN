#!/usr/bin/env bash
# Simulated kind CLI of the preflight tests P01 to P05. It answers only
# "kind version" and "kind version --quiet", with the output format of
# kind 0.33.0 (spec 001, research RS-08). Any other call, "kind create
# cluster" first of all, is logged as UNEXPECTED and fails.
#
# FAKE_KIND_VERSION  version printed, default 0.33.0; an empty value
#                    simulates an output that cannot be read
# FAKE_LOG           file that receives one line per call
set -euo pipefail

log() {
  if [ -n "${FAKE_LOG:-}" ]; then
    printf '%s\n' "$1" >>"$FAKE_LOG"
  fi
}

log "kind $*"

version="${FAKE_KIND_VERSION-0.33.0}"
case "$*" in
  version)
    printf 'kind v%s go1.27.1 darwin/arm64\n' "$version"
    ;;
  "version --quiet" | "version -q" | "--quiet version" | "-q version")
    printf '%s\n' "$version"
    ;;
  *)
    log "UNEXPECTED kind $*"
    printf 'fake kind: unexpected call: kind %s\n' "$*" >&2
    exit 99
    ;;
esac
