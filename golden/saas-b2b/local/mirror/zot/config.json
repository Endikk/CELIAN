{
    "distSpecVersion": "1.1.1",
    "storage": {
        "rootDirectory": "/home/nonroot",
        "dedupe": false,
        "gc": false
    },
    "http": {
        "address": "0.0.0.0",
        "port": "5000",
        "compat": [
            "docker2s2"
        ],
        "accessControl": {
            "repositories": {
                "**": {
                    "anonymousPolicy": [
                        "read"
                    ]
                }
            }
        }
    },
    "log": {
        "level": "info"
    },
    "extensions": {
        "sync": {
            "enable": true,
            "registries": [
                {
                    "urls": [
                        "https://index.docker.io"
                    ],
                    "onDemand": true,
                    "tlsVerify": true
                }
            ]
        }
    }
}
