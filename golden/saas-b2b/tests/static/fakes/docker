#!/usr/bin/env bash
# A stand-in for docker, used by S26 (tests/static/s26-scan-policy.sh) to read
# what tests/scan/scan-images.sh asks of the engine, without building
# anything. S26 copies it into a temporary directory first on PATH, next to
# fake trivy. It knows the three commands that the scan runs and refuses any
# other, so that a new call shows up in S26:
# - docker.log gets one "ARGS" line per call, the arguments joined by "|";
# - docker context inspect prints the address of a socket that does not exist;
# - docker build keeps the platform it was asked for in built-platform, which
#   fake trivy writes into the report of the image, and fails when docker-mode
#   holds "build-fails";
# - docker rmi does nothing.
set -euo pipefail

here="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

joined="$(
  IFS='|'
  printf '%s' "$*"
)"
printf 'ARGS %s\n' "$joined" >>"$here/docker.log"

case "${1:-}" in
  context)
    printf 'unix:///fake/docker.sock\n'
    ;;
  build)
    if [ "$(cat "$here/docker-mode")" = build-fails ]; then
      echo "fake docker: the build failed, as asked by S26" >&2
      exit 1
    fi
    previous=""
    for arg in "$@"; do
      if [ "$previous" = "--platform" ]; then
        printf '%s\n' "${arg#linux/}" >"$here/built-platform"
      fi
      previous="$arg"
    done
    printf 'sha256:%064d\n' 0
    ;;
  rmi) ;;
  *)
    echo "fake docker: unexpected command: $*" >&2
    exit 2
    ;;
esac
