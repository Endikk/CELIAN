#!/usr/bin/env bash
# A stand-in for trivy, used by S26 (tests/static/s26-scan-policy.sh) to read
# what tests/scan/scan-images.sh passes to Trivy, without network. S26 copies
# it into a temporary directory first on PATH, next to fake docker. The scan
# runs Trivy under env -i, so this file finds its log and its modes next to
# itself:
# - trivy.log gets one "ARGS" line per call, the arguments joined by "|",
#   then one "ENV" line per variable of the environment;
# - mode is the behaviour for a pulled image (--image-src remote):
#   "ok" writes an empty report of schema 2 to --output; "dbfail" fails as
#   Trivy 0.76.2 does when no database repository answers (research RS-22);
#   "novariant" fails as Trivy does when the index of an image has no variant
#   for the platform asked with --platform linux/arm64; "high" writes a report
#   of schema 2 with one CRITICAL and two HIGH identifiers: CVE-2099-1001
#   (fixed), CVE-2099-1002 (fixed, found in two targets) and CVE-2099-1003 (no
#   fixed version), for the decision of the scan on reported images (S26);
# - built-mode is the behaviour for a built image, read from the engine of
#   the machine (--image-src docker), its platform being the one that fake
#   docker saw in the build (built-platform): "clean" writes a report with an
#   OS, one result and no finding, and a small CycloneDX SBOM for --format
#   cyclonedx; "high" adds one HIGH finding; "empty" writes a report without
#   Results nor Metadata.OS; "wrong-arch" writes the report of the other
#   variant; "sbom-empty" writes an empty SBOM file.
set -euo pipefail

here="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
log="$here/trivy.log"

joined="$(
  IFS='|'
  printf '%s' "$*"
)"
printf 'ARGS %s\n' "$joined" >>"$log"
env | LC_ALL=C sort | sed -e 's/^/ENV /' >>"$log"

output=""
image=""
source=""
format=""
platform=""
previous=""
for arg in "$@"; do
  case "$previous" in
    --output) output="$arg" ;;
    --image-src) source="$arg" ;;
    --format) format="$arg" ;;
    --platform) platform="$arg" ;;
  esac
  previous="$arg"
  image="$arg"
done

[ -n "$output" ] || {
  echo "fake trivy: no --output given" >&2
  exit 2
}

vulnerability() {
  printf '{"VulnerabilityID": "%s", "PkgName": "libfake", "InstalledVersion": "1.0", "FixedVersion": "%s", "Severity": "%s"}' "$1" "$2" "$3"
}

# built IMAGE: the report or the SBOM of an image built by the scan.
built() {
  local mode architecture other
  mode="$(cat "$here/built-mode")"
  architecture="$(cat "$here/built-platform")"
  other=amd64
  [ "$architecture" = amd64 ] && other=arm64
  if [ "$format" = cyclonedx ]; then
    case "$mode" in
      sbom-empty) : >"$output" ;;
      *) printf '{\n  "bomFormat": "CycloneDX",\n  "specVersion": "1.7",\n  "components": [{"type": "library", "name": "libfake"}],\n  "vulnerabilities": []\n}\n' >"$output" ;;
    esac
    return 0
  fi
  case "$mode" in
    empty)
      printf '{"SchemaVersion": 2, "ArtifactName": "%s", "ArtifactType": "container_image", "Metadata": {"ImageConfig": {"architecture": "%s", "os": "linux"}}}\n' \
        "$image" "$architecture" >"$output"
      ;;
    wrong-arch)
      printf '{"SchemaVersion": 2, "ArtifactName": "%s", "ArtifactType": "container_image", "Metadata": {"OS": {"Family": "debian", "Name": "13.7"}, "ImageConfig": {"architecture": "%s", "os": "linux"}}, "Results": [{"Target": "a", "Vulnerabilities": []}]}\n' \
        "$image" "$other" >"$output"
      ;;
    high)
      printf '{"SchemaVersion": 2, "ArtifactName": "%s", "ArtifactType": "container_image", "Metadata": {"OS": {"Family": "debian", "Name": "13.7"}, "ImageConfig": {"architecture": "%s", "os": "linux"}}, "Results": [{"Target": "a", "Vulnerabilities": [%s]}]}\n' \
        "$image" "$architecture" "$(vulnerability CVE-2099-1001 1.1 HIGH)" >"$output"
      ;;
    *)
      printf '{"SchemaVersion": 2, "ArtifactName": "%s", "ArtifactType": "container_image", "Metadata": {"OS": {"Family": "debian", "Name": "13.7"}, "ImageConfig": {"architecture": "%s", "os": "linux"}}, "Results": [{"Target": "a", "Vulnerabilities": []}]}\n' \
        "$image" "$architecture" >"$output"
      ;;
  esac
}

if [ "$source" = docker ]; then
  built
  exit 0
fi

case "$(cat "$here/mode")" in
  dbfail)
    echo "FATAL Fatal error run error: init error: DB error: failed to download vulnerability DB: fake of S26" >&2
    exit 1
    ;;
  novariant)
    if [ "$platform" = linux/arm64 ]; then
      echo "FATAL Fatal error run error: unable to find the specified image \"$image\" in [\"remote\"]: remote error: no child with platform linux/arm64 in index $image" >&2
      exit 1
    fi
    printf '{"SchemaVersion": 2, "ArtifactName": "%s", "ArtifactType": "container_image"}\n' "$image" >"$output"
    ;;
  ok)
    printf '{"SchemaVersion": 2, "ArtifactName": "%s", "ArtifactType": "container_image"}\n' "$image" >"$output"
    ;;
  high)
    {
      printf '{"SchemaVersion": 2, "ArtifactName": "%s", "ArtifactType": "container_image", "Results": [' "$image"
      printf '{"Target": "a", "Vulnerabilities": [%s, %s]}, ' "$(vulnerability CVE-2099-1001 1.1 CRITICAL)" "$(vulnerability CVE-2099-1002 1.1 HIGH)"
      printf '{"Target": "b", "Vulnerabilities": [%s, %s]}' "$(vulnerability CVE-2099-1002 1.1 HIGH)" "$(vulnerability CVE-2099-1003 '' HIGH)"
      printf ']}\n'
    } >"$output"
    ;;
  *)
    echo "fake trivy: unknown mode" >&2
    exit 2
    ;;
esac
