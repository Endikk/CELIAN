<!--
  U01, unit tests of the API (spec 001, plan matrix). xUnit.net v3 on the
  Microsoft Testing Platform: the project is an executable, and
  `dotnet run` runs the tests (research RS-18). They run in the build image,
  never on the machine (research RS-06): tests/unit/u01-api.sh.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Api/Api.csproj" />
  </ItemGroup>

  <!-- The committed OpenAPI document of the API, compared with the one the
       tests generate (research RS-03). -->
  <ItemGroup Condition="Exists('../Api/openapi.json')">
    <None Include="../Api/openapi.json" Link="openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
