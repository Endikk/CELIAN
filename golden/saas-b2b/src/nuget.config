<?xml version="1.0" encoding="utf-8"?>
<!--
  One package source, nuget.org, whatever the machine or user configuration
  says: <clear /> drops every source defined elsewhere (research RS-18).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
