# npm settings of the front, read by every npm command run in this folder
# (research RS-18 of spec 001 in CELIAN).
# No install script of any package runs: npm run build and npm test still
# run their own script.
ignore-scripts=true
# No dependency report sent to the registry at each install: the image scan
# and Renovate decide on vulnerabilities.
audit=false
# No check of the registry for a newer npm.
update-notifier=false
