<!--
  Example API of the SaaS B2B golden repo (spec 001, FR-009): health, readiness
  and notes, served under /api by the API itself (plan, "Routage et adresses").
  Npgsql only, no ORM (research RS-03); version and date in research RS-18.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- openapi.json describes the routes for S20 and the tests; the image does
       not ship it, and no route serves it (research RS-03). -->
  <ItemGroup>
    <Content Remove="openapi.json" />
    <None Include="openapi.json" />
  </ItemGroup>
</Project>
