# S15: the registry of the providers of the gcp layer (spec 001, FR-011;
# ADR-008, condition 7; research RS-16). Every provider is declared in
# required_providers with a source that names the registry of OpenTofu:
# registry.opentofu.org/<namespace>/<type>. OpenTofu reads the same address
# whether the host is written or not, so the lock does not change. Written,
# the host tells Renovate where to look up the versions and their dates
# without reading the lock: a lock regenerated by Terraform, on
# registry.terraform.io, would otherwise move the lookup without a trace.
# The lock itself is checked by S14.
#
# Input: the .tf files of one root, given to `conftest test --combine`, a
# list of objects with a `path` and the parsed `contents` (research RS-18).
package tofu_registry

label := "S15 (FR-011; ADR-008, condition 7; research RS-16)"

tf_files contains file if {
	some file in input
	endswith(file.path, ".tf")
}

# Every entry of every required_providers block, with its file. The value is
# an object (source, version) or, in the old form, a version string.
required contains {"path": file.path, "name": name, "value": value} if {
	some file in tf_files
	some settings in object.get(file.contents, "terraform", [])
	some block in object.get(settings, "required_providers", [])
	some name, value in block
}

declared_names := {entry.name | some entry in required}

source_of(value) := value.source if {
	is_object(value)
	is_string(value.source)
} else := ""

host_ok(source) if regex.match(`^registry\.opentofu\.org/[^/]+/[^/]+$`, source)

deny contains msg if {
	some entry in required
	source_of(entry.value) == ""
	msg := sprintf("%s: %s: required_providers.%s has no source; write source = \"registry.opentofu.org/<namespace>/<type>\"", [label, entry.path, entry.name])
}

deny contains msg if {
	some entry in required
	source := source_of(entry.value)
	source != ""
	not host_ok(source)
	msg := sprintf("%s: %s: required_providers.%s has source '%s'; write registry.opentofu.org/<namespace>/<type>, so that the registry of the lookups does not depend on the lock", [label, entry.path, entry.name, source])
}

# A provider block with no entry in required_providers takes the implicit
# source hashicorp/<name>, again without the host.
deny contains msg if {
	some file in tf_files
	some name, _ in object.get(file.contents, "provider", {})
	not name in declared_names
	msg := sprintf("%s: %s: provider %s is configured but not declared in required_providers; its implicit source has no registry host", [label, file.path, name])
}
